      "locked": false,
      "text": "Q02 — Écrivez-vous quelque chose en vol,\nou seulement racontez-vous au retour ?",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "e143",
      "originalText": "Q02 — Écrivez-vous quelque chose en vol,\nou seulement racontez-vous au retour ?",
